# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ── LLM ─────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ──# Multi-LLM Routing (Optional for speed)
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ── LangSmith Observability (Optional but recommended for production)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=policycrab_prod

# Database for Policy/Claim History (SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=PolicyCrab <info@policycrab.tech>

# ── Redis (task status store) ───────────────────────────────
# Free Upstash Redis instance — 10K commands/day, no worker dyno needed.
# Sign up free at https://upstash.com — use the rediss:// (TLS) URL.
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# ── Abuse protection ───────────────────────────────────────
# In-process API limits are enabled in code. Use Redis/edge limits in production multi-instance deployments.

# ── Cloudflare ─────────────────────────────────────────────
# Set CLOUDFLARE_ENABLED=true on Heroku after DNS migration.
# Set CLOUDFLARE_ONLY=true after confirming ALL traffic routes via CF.
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ONLY=false

ADMIN_EMAILS=your.email@example.com
