# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ── LLM ─────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ──# Multi-LLM Routing (Optional for speed)
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# ── LangSmith Observability (Optional but recommended for production)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=policycrab_prod

# Database for Policy/Claim History (SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=PolicyCrab <info@policycrab.tech>

# ── Abuse protection ───────────────────────────────────────
# In-process API limits are enabled in code. Use Redis/edge limits in production multi-instance deployments.

# ── Optional feature flags (all default to off / safe values) ──────────────
# Accuracy Core
CITATION_UNVERIFIED_POLICY=annotate      # annotate | strip | off
CITATION_POLICY_FUZZY_THRESHOLD=0.85
QUALITY_GATE_MODE=warn                   # off | warn | block
# Team workspaces (requires supabase/migrations/009)
ORGS_ENABLED=false
APP_BASE_URL=https://policycrab.tech     # used to build invitation links
ORG_INVITATION_TTL_DAYS=7
# Usage metering & audit trail (require supabase/migrations/010)
USAGE_METERING_ENABLED=false
AUDIT_TRAIL_ENABLED=false
# API keys for integrations (requires supabase/migrations/011)
API_KEYS_ENABLED=false
# Case management (requires supabase/migrations/013)
CASES_ENABLED=false
# Platform admins (comma-separated emails)
ADMIN_EMAILS=
